# 101tags mobile — environment configuration
#
# Las variables EXPO_PUBLIC_* se inyectan al bundle en build-time y son
# legibles vía `process.env.EXPO_PUBLIC_*` en el código (también disponible
# vía `expo-constants` en runtime nativo).
#
# IMPORTANTE: estas mismas variables también están declaradas en
#   - app.json → bloque "extra" (defaults consumidos por `Constants.expoConfig.extra`)
#   - eas.json → bloque "build.<profile>.env" (EAS Build overrides por profile)
#
# El orden de precedencia en runtime es:
#   1. EXPO_PUBLIC_API_BASE_URL (env var / eas.json env block)
#   2. __DEV__ defaults (iOS sim localhost:8000, Android emu 10.0.2.2:8000, web localhost:8080)
#   3. throw en release build (sin fallback silencioso a localhost)
#
# Este archivo es solo documentación — NO commitear un `.env` real con
# secretos. Ver AGENTS.md §Seguridad.

# Backend API base URL (debe terminar en `/api`).
# Dev nativo iOS sim:        http://localhost:8000/api
# Dev nativo Android emu:    http://10.0.2.2:8000/api
# Dev web:                   http://localhost:8080/api
# Preview / Production:      https://api.101tags.com/api
EXPO_PUBLIC_API_BASE_URL=http://localhost:8000/api

# Entorno de build: development | preview | production
EXPO_PUBLIC_ENV=development

# Timeout HTTP en milisegundos.
# Default dev:     15000
# Default prod:    30000
EXPO_PUBLIC_API_TIMEOUT_MS=15000
